# Stripe — copy into .env.local (never commit real keys)
# Docs: https://docs.stripe.com/keys

# --- Sandbox (test mode) — use while developing ---
# Dashboard: https://dashboard.stripe.com/test/apikeys

# Server-side only. Secret (sk_test_) or restricted (rk_test_) — see keys best practices.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Optional. Safe for browser if you add Stripe.js later (Checkout redirect does not require it).
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Webhook signing secret — NOT an API key. Per endpoint in Dashboard → Webhooks.
# Local: run `stripe listen --forward-to localhost:3000/api/stripe/webhook` and copy whsec_ from CLI.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Price IDs from Products (test mode) — must start with price_
STRIPE_PRICE_PRO_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_PRO_YEARLY=price_REPLACE_ME

# --- Live mode (production only) ---
# Toggle Dashboard to live mode, then use sk_live_/rk_live_, pk_live_, new live webhook whsec_.
# https://docs.stripe.com/keys#switch-to-live-mode
